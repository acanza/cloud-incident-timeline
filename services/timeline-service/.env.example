# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB
TIMELINE_TABLE_NAME=cloud-incident-timeline-dev-incident-timeline

# SQS Queue URLs
TIMELINE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/cloud-incident-timeline-dev-timeline-queue

# EventBridge (required only if implementing comment creation)
EVENT_BUS_NAME=cloud-incident-timeline-dev-event-bus

# Service Configuration
SERVICE_NAME=timeline-service
LOG_LEVEL=INFO

# Container Port (default: 8080)
PORT=8080

# SQS Consumer (default: false, set to true to enable)
# Requires AWS credentials configured (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# For local development, leave as false to test only HTTP API
START_CONSUMER=false
